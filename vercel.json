{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "installCommand": "",
  "framework": null,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/ai-agents",
      "destination": "/ai-agents.html"
    },
    {
      "source": "/ai-agents/",
      "destination": "/ai-agents.html"
    },
    {
      "source": "/ai-automation",
      "destination": "/ai-automation.html"
    },
    {
      "source": "/ai-automation/",
      "destination": "/ai-automation.html"
    },
    {
      "source": "/ai-consulting",
      "destination": "/ai-consulting.html"
    },
    {
      "source": "/ai-consulting/",
      "destination": "/ai-consulting.html"
    },
    {
      "source": "/ai-development",
      "destination": "/ai-development.html"
    },
    {
      "source": "/ai-development/",
      "destination": "/ai-development.html"
    },
    {
      "source": "/locations/melbourne",
      "destination": "/locations-melbourne.html"
    },
    {
      "source": "/locations/melbourne/",
      "destination": "/locations-melbourne.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
